---
import Base from '../layouts/Base.astro';
import { formatDate, url, type Post } from '../lib/posts';

interface Props {
	title: string;
	posts: Post[];
}

const { title, posts } = Astro.props;
---

<Base title={title}>
	<h1>{title}</h1>
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={url(`/${post.id}/`)}>{post.data.title}</a>{' '}
					<span> - {formatDate(post.data.date)}</span>
				</li>
			))
		}
	</ul>
</Base>
